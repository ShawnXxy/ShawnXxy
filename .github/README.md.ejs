<% if (plugins.achievements) { %>
## Achievements

<% if (pluginError(plugins.achievements)) { %>
> **Achievement data unavailable:** <%= pluginError(plugins.achievements) %>
<% } else if (plugins.achievements.list?.length) { %>
| Achievement | Rank | Description | Details |
| :-- | :--: | :-- | :-- |
<% for (const achievement of plugins.achievements.list) {
  const details = [];
  if (typeof achievement.value === "number")
    details.push(`Value: ${f(Math.floor(achievement.value))}`);
  else if (achievement.value)
    details.push(`Value: ${achievement.value}`);
  if (achievement.leaderboard)
    details.push(`Ranked ${f(achievement.leaderboard.user)} of ${f(achievement.leaderboard.total)} ${achievement.leaderboard.type}`);
  if (achievement.unlock)
    details.push(`Unlocked ${achievement.unlock}`);
  if (achievement.progress)
    details.push(`Progress: ${f.percentage(achievement.progress)}`);
  const achievementName = achievement.prefix ? `${achievement.prefix} ${achievement.title}` : achievement.title;
-%>
| **<%= mdCell(achievementName) %>** | <%= achievement.rank === "$" ? "Secret" : achievement.rank %> | <%= mdCell(achievement.text) %> | <%= mdCell(details.join("; ") || "—") %> |
<% } -%>
<% } else { %>
No achievements matched the configured threshold.
<% } %>
<% } %>

<% if (plugins.code) { %>
## Code snippet of the day

<% if (pluginError(plugins.code)) { %>
> **Code snippet unavailable:** <%= pluginError(plugins.code) %>
<% } else if (plugins.code.snippet) { const snippet = plugins.code.snippet; const codeText = snippetText(snippet.patch); const codeFence = fenceFor(codeText); %>
- Repository: [<%= snippet.repo %>](https://github.com/<%= snippet.repo %>)
- Commit: [`<%= snippet.sha.substring(0, 8) %>`](https://github.com/<%= snippet.repo %>/commit/<%= snippet.sha %>)
- File: [<%- codeSpan(snippet.filename) %>](https://github.com/<%= snippet.repo %>/blob/<%= snippet.sha %>/<%= snippet.filename.split("/").map(encodeURIComponent).join("/") %>)
- Message: <%= plainText(snippet.message) %>
- Updated: <%= f.date(snippet.created, {time: true, date: true, timeZone: config.timezone?.name}) %>

<%= codeFence %>diff
<%- codeText %>
<%= codeFence %>
<% } else { %>
No recent code snippet was found.
<% } %>
