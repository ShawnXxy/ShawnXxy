<%
const activity = plugins.activity;
// The fork omits ref/delete; retain its renderer for every other event.
if (!activity?.error && activity?.events?.some(event => event.type === "ref/delete")) {
  for (const [index, event] of activity.events.entries()) {
    const entry = await include("partials/activity.ejs", {plugins: {...plugins, activity: {...activity, events: [event]}}});
    const headingEnd = entry.indexOf("\n") + 1;
    if (index === 0) {
%><%- entry.slice(0, headingEnd) %><%
    }
    if (event.type === "ref/delete") {
%>* &#128686; Deleted <%= event.ref.type %> <code><%= event.ref.name %></code> from [<%= event.repo %>](https://github.com/<%= event.repo %>)
<% if (activity.timestamps) { %>  * *On <%= f.date(event.timestamp, {time: true, date: true, timeZone: config.timezone?.name}) %>*
<% } %>
<% } else { %><%- entry.slice(headingEnd) %><% }
  }
} else { %><%- await include("partials/activity.ejs") %><% } %>

<%
const plainText = value => `${value ?? ""}`.replace(/\r?\n/g, " ");
const mdCell = value => plainText(value).replace(/\|/g, "\\|");
const pluginError = plugin => plugin?.error?.message ? plainText(plugin.error.message) : null;
const numericEntries = values => Object.entries(values ?? {})
  .filter(([key]) => /^\d+$/.test(key))
  .sort(([a], [b]) => Number(a) - Number(b));
const snippetText = patch => `${patch ?? ""}`
  .replace(/<br\s*\/?>/gi, "\n")
  .replace(/<\/?span\b[^>]*>/gi, "")
  .replace(/&lt;/g, "<")
  .replace(/&gt;/g, ">")
  .replace(/&quot;/g, '"')
  .replace(/&#(?:39|x27);/gi, "'")
  .replace(/&amp;/g, "&")
  .replace(/\r\n?/g, "\n");
const fenceFor = text => {
  const runs = `${text}`.match(/`+/g) ?? [];
  return "`".repeat(Math.max(3, ...runs.map(run => run.length + 1)));
};
const codeSpan = value => {
  const text = plainText(value);
  const delimiter = fenceFor(text);
  return `${delimiter} ${text} ${delimiter}`;
};
const reactionIcons = {
  HEART: "❤️",
  THUMBS_UP: "👍",
  THUMBS_DOWN: "👎",
  LAUGH: "😄",
  CONFUSED: "😕",
  EYES: "👀",
  ROCKET: "🚀",
  HOORAY: "🎉",
};
const dayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
const licensePreference = computed.licenses?.favorite?.length
  ? f.license(computed.licenses.about[computed.licenses.favorite])
  : "No preference";
const repositorySummary = computed.repositories?.forked
  ? `${f(REPOSITORIES)} (${f(computed.repositories.forked)} forks)`
  : f(REPOSITORIES);
const linesSummary = plugins.lines
  ? pluginError(plugins.lines) ?? `${f(plugins.lines.added + plugins.lines.changed)} added / ${f(plugins.lines.deleted + plugins.lines.changed)} removed`
  : "Not enabled";
const trafficSummary = plugins.traffic
  ? pluginError(plugins.traffic) ?? `${f(plugins.traffic.views.count)} views / ${f(plugins.traffic.views.uniques)} unique visitors in the last two weeks`
  : "Not enabled";
%>

